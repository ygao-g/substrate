# Substrate ActorTemplate resource (protojson-shaped ateapi.ActorTemplate,
# NOT the ate.dev/v1 CRD) for the Nighthawk traffic-driver actor workload,
# deployed into the ${ATESPACE} atespace.
#
# Runs Envoy's stock nighthawk_service gRPC server on port 80 (the default actor
# ingress port forwarded by atunnel) so benchmark runners can invoke
# ExecutionStream through atenet-router to drive HTTP/HTTPS load from inside
# the gVisor actor sandbox.
metadata:
  atespace: "${ATESPACE}"
  name: traffic-driver
workerSelector:
  matchLabels:
    workload: "${WORKER_WORKLOAD}"
containers:
- name: nighthawk-service
  image: envoyproxy/nighthawk-dev@sha256:7729902afea9d83f593b240690ba7d6e8fff04f6215ada538cfb4c1452b2553e
  command:
  - /usr/local/bin/nighthawk_service
  args:
  - --listen
  - 0.0.0.0:80
  - --service
  - traffic-generator-service
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
volumes:
- name: system-info
  systemInfo:
    dataSources:
    # Trust anchors for per-SNI leaf certificates minted by the egress gateway
    # when terminating HTTPS egress traffic.
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: egress-trust-bundle/trust-bundle.pem
resources:
  limits:
    cpuMillicores: "${ACTOR_CPU_MILLICORES}"
    memoryBytes: "${ACTOR_MEMORY_BYTES}"
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
